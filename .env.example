# Copiez ce fichier en ".env" puis remplacez les valeurs. Ne publiez JAMAIS le fichier .env.

# Base PostgreSQL. En local : localhost. Avec docker compose, la valeur est remplacée automatiquement.
POSTGRES_USER=atelier
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=atelier
DATABASE_URL=postgresql+psycopg://atelier:changez-moi@localhost:5432/atelier

# Clé secrète pour signer les jetons JWT (longue chaîne aléatoire)
# Pour en générer une :  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
DUREE_JETON_MINUTES=60

# Premier administrateur créé par "python -m app.seed"
ADMIN_EMAIL=admin@atelier.sn
ADMIN_NOM=Mamadou (patron)
ADMIN_MOT_DE_PASSE=changez-moi-admin

# Mot de passe des comptes de démonstration accueil@atelier.sn et tailleur@atelier.sn (laisser vide pour ne pas les créer)
DEMO_MOT_DE_PASSE=changez-moi-demo
